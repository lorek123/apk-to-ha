GRAPHQL_PATH = "{{ graphql_path }}"
API_KEY_HEADER: str | None = {{ ('"' ~ api_key_header ~ '"') if api_key_header else "None" }}
API_KEY = "test-api-key"
STATE_QUERIES = {{ poll_queries | map(attribute="name") | list | tojson }}
