{# Action tests, appended to each transport's test module. The includer sets
   `fixture` (test parameters) and `setup` (the entry setup call). #}
{% if test_action %}


ACTION_DATA: dict[str, Any] = json.loads({{ test_action.sample_data | tojson | tojson }})


async def test_action_sends_command({{ fixture }}) -> None:
    """The {{ test_action.name }} action sends {{ test_action.cmd }} with its parameters."""
    entry = await {{ setup }}
    await hass.services.async_call(
        DOMAIN,
        {{ test_action.name | tojson }},
        {ATTR_CONFIG_ENTRY_ID: entry.entry_id, **ACTION_DATA},
        blocking=True,
    )
{% if transport == "http_rest" %}
    method, path, body = mock_device.requests[-1]
    assert (method, path) == (
        {{ test_action.expected.method | tojson }},
        {{ test_action.expected.path | tojson }},
    )
    assert body == json.loads({{ test_action.expected.body | tojson | tojson }})
    assert mock_device.queries[-1] == json.loads({{ test_action.expected.query | tojson | tojson }})
{% elif transport == "graphql" %}
    assert server.mutations[-1] == {{ test_action.operation | tojson }}
    assert server.variables[-1] == json.loads({{ test_action.expected.wire | tojson | tojson }})
{% else %}
    frame = json.loads({{ test_action.expected.ws_frame | tojson | tojson }})
    await _wait_for(lambda: frame in mock_device.received)
{% endif %}


async def test_action_needs_loaded_entry({{ fixture }}) -> None:
    """Actions are registered once; on an unloaded entry they refuse, not crash."""
    entry = await {{ setup }}
    await hass.config_entries.async_unload(entry.entry_id)
    await hass.async_block_till_done()
    with pytest.raises(ServiceValidationError):
        await hass.services.async_call(
            DOMAIN,
            {{ test_action.name | tojson }},
            {ATTR_CONFIG_ENTRY_ID: entry.entry_id, **ACTION_DATA},
            blocking=True,
        )
{% endif %}
{% if test_query_action %}


async def test_query_action_returns_reply({{ fixture }}) -> None:
    """The {{ test_query_action.name }} action returns the device's reply."""
    entry = await {{ setup }}
    response = await hass.services.async_call(
        DOMAIN,
        {{ test_query_action.name | tojson }},
        {
            ATTR_CONFIG_ENTRY_ID: entry.entry_id,
            **json.loads({{ test_query_action.sample_data | tojson | tojson }}),
        },
        blocking=True,
        return_response=True,
    )
{% if transport == "graphql" %}
    assert response == json.loads({{ {test_query_action.operation: true} | tojson | tojson }})
{% else %}
    assert response == {"ok": True}
{% endif %}
{% endif %}
