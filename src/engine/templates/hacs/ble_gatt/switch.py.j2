"""Switch platform for {{ name }}."""
from __future__ import annotations

from typing import Any

from homeassistant.components.switch import SwitchEntity
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddConfigEntryEntitiesCallback

from . import {{ class_prefix }}ConfigEntry
from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity

PARALLEL_UPDATES = 1


async def async_setup_entry(
    hass: HomeAssistant,
    entry: {{ class_prefix }}ConfigEntry,
    async_add_entities: AddConfigEntryEntitiesCallback,
) -> None:
    coordinator = entry.runtime_data
    async_add_entities([
{% for s in gatt.switches %}
        {{ class_prefix }}Switch(coordinator, "{{ s.key }}", coordinator.client.set_{{ s.key }}),
{% endfor %}
    ])


class {{ class_prefix }}Switch({{ class_prefix }}Entity, SwitchEntity):
    def __init__(
        self, coordinator: {{ class_prefix }}Coordinator, key: str, set_on: Any
    ) -> None:
        super().__init__(coordinator, key)
        self._attr_translation_key = key
        self._set_on = set_on

    @property
    def is_on(self) -> bool | None:
        value = self.value
        return None if value is None else bool(value)

    async def async_turn_on(self, **kwargs: Any) -> None:
        await self._send(self._set_on(True), 1)

    async def async_turn_off(self, **kwargs: Any) -> None:
        await self._send(self._set_on(False), 0)
