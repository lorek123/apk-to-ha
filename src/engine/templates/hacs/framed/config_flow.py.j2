"""Config flow for {{ name }}: Bluetooth discovery or pick from devices in range."""
from __future__ import annotations

from typing import Any

import voluptuous as vol
from homeassistant.components import bluetooth
from homeassistant.config_entries import ConfigFlow, ConfigFlowResult
from homeassistant.const import CONF_ADDRESS
from {{ sdk_package }} import (
    {{ class_prefix }}Client,
    {{ class_prefix }}ConnectionError,
    {{ class_prefix }}UnsupportedError,
    matches,
    model,
)

from .const import DOMAIN


class {{ class_prefix }}ConfigFlow(ConfigFlow, domain=DOMAIN):
    """Every device is asked for its device info before its entry is created."""

    VERSION = 1

    def __init__(self) -> None:
        self._discovery: bluetooth.BluetoothServiceInfoBleak | None = None
        self._discovered: dict[str, bluetooth.BluetoothServiceInfoBleak] = {}

    async def async_step_bluetooth(
        self, discovery_info: bluetooth.BluetoothServiceInfoBleak
    ) -> ConfigFlowResult:
        await self.async_set_unique_id(discovery_info.address)
        self._abort_if_unique_id_configured()
        if not matches(discovery_info.manufacturer_data):
            return self.async_abort(reason="not_supported")
        self._discovery = discovery_info
        self.context["title_placeholders"] = {"name": _title(discovery_info)}
        return await self.async_step_bluetooth_confirm()

    async def async_step_bluetooth_confirm(
        self, user_input: dict[str, Any] | None = None
    ) -> ConfigFlowResult:
        assert self._discovery is not None
        errors: dict[str, str] = {}
        if user_input is not None:
            result = await self._probe(self._discovery.address)
            if isinstance(result, str):
                errors["base"] = result
            else:
                return result
        self._set_confirm_only()
        return self.async_show_form(
            step_id="bluetooth_confirm",
            description_placeholders={"name": _title(self._discovery)},
            errors=errors,
        )

    async def async_step_user(
        self, user_input: dict[str, Any] | None = None
    ) -> ConfigFlowResult:
        errors: dict[str, str] = {}
        if user_input is not None:
            address = user_input[CONF_ADDRESS]
            await self.async_set_unique_id(address, raise_on_progress=False)
            self._abort_if_unique_id_configured()
            result = await self._probe(address)
            if isinstance(result, str):
                errors["base"] = result
            else:
                return result

        configured = self._async_current_ids(include_ignore=False)
        for info in bluetooth.async_discovered_service_info(self.hass, connectable=True):
            if info.address not in configured and matches(info.manufacturer_data):
                self._discovered[info.address] = info
        if not self._discovered:
            return self.async_abort(reason="no_devices_found")
        return self.async_show_form(
            step_id="user",
            data_schema=vol.Schema(
                {
                    vol.Required(CONF_ADDRESS): vol.In(
                        {a: _title(i) for a, i in self._discovered.items()}
                    )
                }
            ),
            errors=errors,
        )

    async def _probe(self, address: str) -> ConfigFlowResult | str:
        """The new entry (or an abort) once the device answers; else an error key."""
        ble_device = bluetooth.async_ble_device_from_address(self.hass, address, connectable=True)
        if ble_device is None:
            return "cannot_connect"
        try:
            info = await {{ class_prefix }}Client(ble_device).read_device_info()
        except {{ class_prefix }}UnsupportedError:
            return self.async_abort(reason="not_supported")
        except {{ class_prefix }}ConnectionError:
            return "cannot_connect"
        product_id = info.get("product_id")
        model_name, ble = model(product_id if isinstance(product_id, str) else None)
        if ble is False:
            # The app reaches this model over classic Bluetooth only.
            return self.async_abort(
                reason="unsupported_model", description_placeholders={"model": str(model_name)}
            )
        name = info.get("device_name")
        title = name if isinstance(name, str) and name else (model_name or ble_device.name or address)
        return self.async_create_entry(title=title, data={CONF_ADDRESS: address})


def _title(info: bluetooth.BluetoothServiceInfoBleak) -> str:
    return info.name or info.address
