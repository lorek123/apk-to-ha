"""Switch platform for {{ name }}: settings the app shows as on/off toggles."""
from __future__ import annotations

from dataclasses import dataclass
from typing import Any

from homeassistant.components.switch import SwitchEntity, SwitchEntityDescription
from homeassistant.const import EntityCategory
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddConfigEntryEntitiesCallback

from . import {{ class_prefix }}ConfigEntry
from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity

PARALLEL_UPDATES = 1


@dataclass(frozen=True, kw_only=True)
class {{ class_prefix }}SwitchDescription(SwitchEntityDescription):
    field: str
    on: int
    off: int


SWITCHES: tuple[{{ class_prefix }}SwitchDescription, ...] = (
{% for s in framed.switches %}
    {{ class_prefix }}SwitchDescription(
        key="{{ s.key }}",
        field="{{ s.field }}",
        on={{ s.on }},
        off={{ s.off }},
        entity_category=EntityCategory.CONFIG,
    ),
{% endfor %}
)


async def async_setup_entry(
    hass: HomeAssistant,
    entry: {{ class_prefix }}ConfigEntry,
    async_add_entities: AddConfigEntryEntitiesCallback,
) -> None:
    coordinator = entry.runtime_data
    async_add_entities(
        {{ class_prefix }}Switch(coordinator, d) for d in SWITCHES if d.field in coordinator.data
    )


class {{ class_prefix }}Switch({{ class_prefix }}Entity, SwitchEntity):
    entity_description: {{ class_prefix }}SwitchDescription

    def __init__(
        self, coordinator: {{ class_prefix }}Coordinator, description: {{ class_prefix }}SwitchDescription
    ) -> None:
        super().__init__(coordinator, description.key, description.field)
        self.entity_description = description

    @property
    def is_on(self) -> bool | None:
        value = self.value
        return None if value is None else value == self.entity_description.on

    async def async_turn_on(self, **kwargs: Any) -> None:
        await self._apply(self.entity_description.key, self.entity_description.on)

    async def async_turn_off(self, **kwargs: Any) -> None:
        await self._apply(self.entity_description.key, self.entity_description.off)
