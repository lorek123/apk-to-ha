{
  "domain": "{{ domain }}",
  "name": {{ name | tojson }},
  "bluetooth": [
{% for m in framed.manufacturer_ids %}
    {"connectable": true, "manufacturer_id": {{ m }}}{% if not loop.last %},{% endif %}

{% endfor %}
  ],
  "codeowners": [],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/lorek123/apk-to-ha",
  "integration_type": "device",
  "iot_class": "local_polling",
  "quality_scale": "platinum",
  "requirements": ["{{ sdk_package }}=={{ integration_version }}"],
  "version": "{{ integration_version }}"
}
