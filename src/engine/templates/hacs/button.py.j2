"""Button platform for {{ name }}."""
from __future__ import annotations

from collections.abc import Awaitable, Callable

from homeassistant.components.button import ButtonDeviceClass, ButtonEntity
from homeassistant.config_entries import ConfigEntry
from homeassistant.const import EntityCategory
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddEntitiesCallback

from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity


async def async_setup_entry(
    hass: HomeAssistant,
    entry: ConfigEntry,
    async_add_entities: AddEntitiesCallback,
) -> None:
    coordinator: {{ class_prefix }}Coordinator = entry.runtime_data.coordinator
    client = coordinator.client
    async_add_entities([
{% for btn in buttons %}
        {{ class_prefix }}Button(
            coordinator,
            "{{ btn.key }}",
            "{{ btn.tkey }}",
            client.press_{{ btn.key }},
            maintenance={{ btn.maintenance }},
            device_class={{ "ButtonDeviceClass." ~ (btn.device_class | upper) if btn.device_class else "None" }},
        ),
{% endfor %}
    ])


class {{ class_prefix }}Button({{ class_prefix }}Entity, ButtonEntity):
    def __init__(
        self,
        coordinator: {{ class_prefix }}Coordinator,
        key: str,
        translation_key: str,
        press: Callable[[], Awaitable[None]],
        *,
        maintenance: bool,
        device_class: ButtonDeviceClass | None,
    ) -> None:
        super().__init__(coordinator, key)
        self._attr_translation_key = translation_key
        self._attr_device_class = device_class
        self._press = press
        if maintenance:
            # Resets, debug power toggles, updates: not for everyday dashboards.
            self._attr_entity_category = EntityCategory.CONFIG
            self._attr_entity_registry_enabled_default = False

    async def async_press(self) -> None:
        await self._press()
