"""{{ name }} Home Assistant integration."""
from __future__ import annotations

from dataclasses import dataclass

from homeassistant.config_entries import ConfigEntry
{% if transport == "graphql" %}
from homeassistant.const import CONF_API_KEY, CONF_URL, CONF_VERIFY_SSL, Platform
{% else %}
from homeassistant.const import CONF_HOST, CONF_PORT, Platform
{% endif %}
from homeassistant.core import HomeAssistant
from homeassistant.helpers import aiohttp_client
{% if actions %}
from homeassistant.helpers import config_validation as cv
from homeassistant.helpers.typing import ConfigType
{% endif %}
from {{ sdk_package }} import {{ class_prefix }}Client
{% if has_ble %}
from {{ sdk_package }}.ble_client import {{ class_prefix }}BleClient
{% endif %}

{% if transport != "graphql" %}
from .const import DEFAULT_PORT
{% endif %}
{% if actions %}
from .const import DOMAIN
{% endif %}
from .coordinator import {{ class_prefix }}Coordinator
{% if actions %}
from .services import async_setup_services
{% endif %}
{% if has_ble %}
from .ble_coordinator import {{ class_prefix }}BleCoordinator
{% endif %}

PLATFORMS: list[Platform] = [
{% for p in platforms %}
    Platform.{{ p | upper }},
{% endfor %}
]


@dataclass
class {{ class_prefix }}RuntimeData:
    coordinator: {{ class_prefix }}Coordinator
    client: {{ class_prefix }}Client
{% if has_ble %}
    ble_coordinator: {{ class_prefix }}BleCoordinator
    ble_client: {{ class_prefix }}BleClient
{% endif %}


type {{ class_prefix }}ConfigEntry = ConfigEntry[{{ class_prefix }}RuntimeData]
{% if actions %}

CONFIG_SCHEMA = cv.config_entry_only_config_schema(DOMAIN)


async def async_setup(hass: HomeAssistant, config: ConfigType) -> bool:
    """Register the integration's actions (they target a config entry by ID)."""
    async_setup_services(hass)
    return True
{% endif %}


async def async_setup_entry(hass: HomeAssistant, entry: {{ class_prefix }}ConfigEntry) -> bool:
{% if transport == "graphql" %}
    client = {{ class_prefix }}Client(
        url=entry.data[CONF_URL],
        session=aiohttp_client.async_get_clientsession(hass, verify_ssl=entry.data[CONF_VERIFY_SSL]),
{% if api_key_header %}
        api_key=entry.data[CONF_API_KEY],
{% endif %}
    )
{% else %}
    session = aiohttp_client.async_get_clientsession(hass)
    client = {{ class_prefix }}Client(
        host=entry.data[CONF_HOST],
        port=entry.data.get(CONF_PORT, DEFAULT_PORT),
        session=session,
    )
{% endif %}
    coordinator = {{ class_prefix }}Coordinator(hass, entry, client)
    await coordinator.async_config_entry_first_refresh()
{% if has_ble %}

    ble_client = {{ class_prefix }}BleClient(entry.data[CONF_HOST])
    ble_coordinator = {{ class_prefix }}BleCoordinator(hass, entry, ble_client)
    await ble_coordinator.async_config_entry_first_refresh()

    entry.runtime_data = {{ class_prefix }}RuntimeData(
        coordinator=coordinator,
        client=client,
        ble_coordinator=ble_coordinator,
        ble_client=ble_client,
    )
{% else %}
    entry.runtime_data = {{ class_prefix }}RuntimeData(coordinator=coordinator, client=client)
{% endif %}
    await hass.config_entries.async_forward_entry_setups(entry, PLATFORMS)
    return True


async def async_unload_entry(hass: HomeAssistant, entry: {{ class_prefix }}ConfigEntry) -> bool:
    unload_ok = await hass.config_entries.async_unload_platforms(entry, PLATFORMS)
    if unload_ok:
        await entry.runtime_data.client.disconnect()
{% if has_ble %}
        await entry.runtime_data.ble_client.disconnect()
{% endif %}
    return unload_ok
