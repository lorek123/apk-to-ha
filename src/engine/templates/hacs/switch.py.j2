"""Switch platform for {{ name }}."""
from __future__ import annotations

from typing import Any

from homeassistant.components.switch import SwitchEntity
from homeassistant.config_entries import ConfigEntry
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddEntitiesCallback

from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity


async def async_setup_entry(
    hass: HomeAssistant,
    entry: ConfigEntry,
    async_add_entities: AddEntitiesCallback,
) -> None:
    coordinator: {{ class_prefix }}Coordinator = entry.runtime_data.coordinator
    async_add_entities([
{% for sw in switches %}
        {{ class_prefix }}Switch(coordinator, "{{ sw.key }}", "{{ sw.name }}", "{{ sw.cmd }}"),
{% endfor %}
    ])


class {{ class_prefix }}Switch({{ class_prefix }}Entity, SwitchEntity):
    def __init__(
        self,
        coordinator: {{ class_prefix }}Coordinator,
        key: str,
        name: str,
        cmd: str,
    ) -> None:
        super().__init__(coordinator, key)
        self._attr_name = name
        self._cmd = cmd
        self._is_on: bool | None = None

    @property
    def is_on(self) -> bool | None:
        return self._is_on

    async def async_turn_on(self, **kwargs: Any) -> None:
        await self.coordinator.client.send_command(self._cmd, enable=True)
        self._is_on = True
        self.async_write_ha_state()

    async def async_turn_off(self, **kwargs: Any) -> None:
        await self.coordinator.client.send_command(self._cmd, enable=False)
        self._is_on = False
        self.async_write_ha_state()
