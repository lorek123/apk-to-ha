"""Binary sensor platform for {{ name }}."""
from __future__ import annotations

from homeassistant.components.binary_sensor import BinarySensorDeviceClass, BinarySensorEntity
from homeassistant.config_entries import ConfigEntry
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddEntitiesCallback

from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity


async def async_setup_entry(
    hass: HomeAssistant,
    entry: ConfigEntry,
    async_add_entities: AddEntitiesCallback,
) -> None:
    coordinator: {{ class_prefix }}Coordinator = entry.runtime_data.coordinator
    async_add_entities([
{% for bs in binary_sensors %}
        {{ class_prefix }}BinarySensor(
            coordinator,
            "{{ bs.key }}",
            "{{ bs.tkey }}",
            "{{ bs.attr }}",
            {{ "BinarySensorDeviceClass." ~ (bs.device_class | upper) if bs.device_class else "None" }},
        ),
{% endfor %}
    ])


class {{ class_prefix }}BinarySensor({{ class_prefix }}Entity, BinarySensorEntity):
    def __init__(
        self,
        coordinator: {{ class_prefix }}Coordinator,
        key: str,
        translation_key: str,
        attr: str,
        device_class: BinarySensorDeviceClass | None,
    ) -> None:
        super().__init__(coordinator, key)
        self._attr_translation_key = translation_key
        self._attr_device_class = device_class
        self._attr = attr

    @property
    def is_on(self) -> bool | None:
        if self.coordinator.data is None:
            return None
        return getattr(self.coordinator.data, self._attr, None)
