{
  "config": {
    "step": {
      "user": {
        "title": "Connect to {{ name }}",
        {% if app_summary %}
        "description": "{{ app_summary | replace('"', '\\"') }}",
        {% endif %}
        "data": {
          "host": "IP address or hostname",
          "port": "Port (default {{ ws_port }})"
        }
      }{% if has_zeroconf or has_dhcp %},
      "discovery_confirm": {
        "title": "Discovered {{ name }}",
        "description": "Set up the {{ name }} found at {host}?"
      }{% endif %}

    },
    "error": {
      "cannot_connect": "Failed to connect — check the IP address and that the device is powered on",
      "unknown": "Unexpected error"{% if device_errors %},
{% for e in device_errors %}
      {{ e.key | tojson }}: {{ e.msg | tojson }}{% if not loop.last %},{% endif %}

{% endfor %}
{% endif %}
    },
    "abort": {
      "already_configured": "This device is already configured"
    }
  }{% if entity_sections %},
  "entity": {
{% for platform, entities in entity_sections.items() %}
    {{ platform | tojson }}: {
{% for key, data in entities.items() %}
      {{ key | tojson }}: {"name": {{ data.name | tojson }}}{% if not loop.last %},{% endif %}

{% endfor %}
    }{% if not loop.last %},{% endif %}

{% endfor %}
  }
{% endif %}
}
