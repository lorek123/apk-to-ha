"""Number platform for {{ name }}."""
from __future__ import annotations

from homeassistant.components.number import NumberEntity, NumberMode
from homeassistant.config_entries import ConfigEntry
from homeassistant.core import HomeAssistant
from homeassistant.helpers.entity_platform import AddEntitiesCallback

from .coordinator import {{ class_prefix }}Coordinator
from .entity_base import {{ class_prefix }}Entity


async def async_setup_entry(
    hass: HomeAssistant,
    entry: ConfigEntry,
    async_add_entities: AddEntitiesCallback,
) -> None:
    coordinator: {{ class_prefix }}Coordinator = entry.runtime_data.coordinator
    async_add_entities([
{% for num in numbers %}
        {{ class_prefix }}Number(coordinator, "{{ num.key }}", "{{ num.name }}", "{{ num.cmd }}", "{{ num.param }}"),
{% endfor %}
    ])


class {{ class_prefix }}Number({{ class_prefix }}Entity, NumberEntity):
    _attr_native_min_value = 0
    _attr_native_max_value = 100
    _attr_native_step = 1
    _attr_mode = NumberMode.BOX

    def __init__(
        self,
        coordinator: {{ class_prefix }}Coordinator,
        key: str,
        name: str,
        cmd: str,
        param: str,
    ) -> None:
        super().__init__(coordinator, key)
        self._attr_name = name
        self._cmd = cmd
        self._param = param
        self._attr_native_value: float | None = None

    @property
    def native_value(self) -> float | None:
        return self._attr_native_value

    async def async_set_native_value(self, value: float) -> None:
        await self.coordinator.client.send_command(self._cmd, **{self._param: int(value)})
        self._attr_native_value = value
        self.async_write_ha_state()
