from __future__ import annotations

import asyncio
import logging
from collections.abc import Callable
from typing import Any

from bleak import BleakClient, BleakError
from bleak.backends.characteristic import BleakGATTCharacteristic

_LOGGER = logging.getLogger(__name__)

_RECONNECT_DELAY: float = 5.0
_MAX_RECONNECT_ATTEMPTS: int = 3
{% if ble_service_uuids %}

SERVICE_UUIDS: list[str] = [
{% for u in ble_service_uuids %}
    "{{ u }}",
{% endfor %}
]
{% endif %}


class {{ class_prefix }}BleClient:
    """Async BLE GATT client for {{ name }}.

    Usage::

        async with {{ class_prefix }}BleClient(address) as client:
            data = await client.read_{{ ble_chars[0].key }}()
    """

    def __init__(self, address: str) -> None:
        self._address = address
        self._client: BleakClient | None = None
        self._connected: bool = False
        self._notify_callbacks: dict[str, list[Callable[[bytearray], None]]] = {}

    # ── connection lifecycle ──────────────────────────────────────────────────

    @property
    def address(self) -> str:
        return self._address

    @property
    def is_connected(self) -> bool:
        return (
            self._connected
            and self._client is not None
            and self._client.is_connected
        )

    async def connect(self) -> None:
        """Connect to the device, retrying up to _MAX_RECONNECT_ATTEMPTS times."""
        for attempt in range(_MAX_RECONNECT_ATTEMPTS):
            try:
                self._client = BleakClient(
                    self._address,
                    disconnected_callback=self._on_disconnect,
                )
                await self._client.connect()
                self._connected = True
                _LOGGER.debug("BLE connected to %s", self._address)
                return
            except BleakError as exc:
                _LOGGER.warning(
                    "BLE connect attempt %d/%d failed: %s",
                    attempt + 1, _MAX_RECONNECT_ATTEMPTS, exc,
                )
                if attempt < _MAX_RECONNECT_ATTEMPTS - 1:
                    await asyncio.sleep(_RECONNECT_DELAY)
        raise BleakError(
            f"Failed to connect to {self._address} after {_MAX_RECONNECT_ATTEMPTS} attempts"
        )

    async def disconnect(self) -> None:
        """Disconnect from the device."""
        self._connected = False
        if self._client and self._client.is_connected:
            await self._client.disconnect()
        self._client = None

    async def ensure_connected(self) -> None:
        """Reconnect if the connection was dropped."""
        if not self.is_connected:
            await self.connect()

    async def __aenter__(self) -> "{{ class_prefix }}BleClient":
        await self.connect()
        return self

    async def __aexit__(self, *_args: Any) -> None:
        await self.disconnect()

    def _on_disconnect(self, _client: BleakClient) -> None:
        self._connected = False
        _LOGGER.debug("BLE disconnected from %s", self._address)

    # ── characteristic access ─────────────────────────────────────────────────
{% for char in ble_chars %}
{% if "write" in char.access %}

    async def write_{{ char.key }}(self, data: bytes) -> None:
        """Write bytes to characteristic {{ char.uuid }}."""
        await self.ensure_connected()
        assert self._client is not None
        await self._client.write_gatt_char("{{ char.uuid }}", data)
{% endif %}
{% if "read" in char.access %}

    async def read_{{ char.key }}(self) -> bytearray:
        """Read bytes from characteristic {{ char.uuid }}."""
        await self.ensure_connected()
        assert self._client is not None
        return await self._client.read_gatt_char("{{ char.uuid }}")
{% endif %}
{% if "notify" in char.access %}

    def on_{{ char.key }}_update(self, callback: Callable[[bytearray], None]) -> None:
        """Register a notification callback for characteristic {{ char.uuid }}."""
        self._notify_callbacks.setdefault("{{ char.uuid }}", []).append(callback)

    async def start_{{ char.key }}_notify(self) -> None:
        """Subscribe to notifications from characteristic {{ char.uuid }}."""
        await self.ensure_connected()
        assert self._client is not None
        await self._client.start_notify(
            "{{ char.uuid }}", self._handle_{{ char.key }}_notify
        )

    async def stop_{{ char.key }}_notify(self) -> None:
        """Unsubscribe from notifications on characteristic {{ char.uuid }}."""
        await self.ensure_connected()
        assert self._client is not None
        await self._client.stop_notify("{{ char.uuid }}")

    def _handle_{{ char.key }}_notify(
        self,
        _characteristic: BleakGATTCharacteristic,
        data: bytearray,
    ) -> None:
        for cb in self._notify_callbacks.get("{{ char.uuid }}", []):
            cb(data)
{% endif %}
{% endfor %}
